rules_version = '2';

// Public read-only history powers the 24-hour market board.
service cloud.firestore {
  match /databases/{database}/documents {
    match /public/latest {
      allow read: if true;
      allow write: if false;
    }

    match /historicalSnapshots/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
